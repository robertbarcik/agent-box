{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:BOX_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["/opt/agent-box/AGENTS.md"],
  "permission": {
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "http://gateway:8080/api/v1"
      }
    }
  }
}
