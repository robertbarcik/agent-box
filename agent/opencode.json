{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:BOX_MODEL}",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["/opt/agent-box/AGENTS.md"],
  "permission": {
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "http://gateway:8080/api/v1"
      },
      "models": {
        "z-ai/glm-5.3": {
          "limit": { "context": 1048576, "output": 96000 },
          "options": { "reasoning": { "effort": "low" } }
        },
        "z-ai/glm-5.3:online": {
          "limit": { "context": 1048576, "output": 96000 },
          "options": { "reasoning": { "effort": "low" } }
        }
      }
    }
  }
}
