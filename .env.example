# Copy to .env (bin/box up does it for you) and fill in the key.
# .env is in .gitignore: it never leaves your machine.

# A DEDICATED OpenRouter key with a hard credit limit (openrouter.ai > Keys > Create key >
# Credit limit). Only the gateway container sees it. The agent never does.
OPENROUTER_API_KEY=

# The model the agent uses: "openrouter/" + the model id from openrouter.ai/models.
BOX_MODEL=openrouter/z-ai/glm-5.3

# The opencode release baked into the image. Change it, then: bin/box up
OPENCODE_VERSION=1.19.5

# How much of your machine the agent may use.
BOX_MEMORY=4g
BOX_CPUS=4
