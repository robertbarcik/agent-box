# Copy to .env (bin/box up does it for you) and fill in the key.
# .env is in .gitignore: it never leaves your machine.

# A DEDICATED OpenRouter key with a hard credit limit (openrouter.ai > Keys > Create key >
# Credit limit). Only the gateway container sees it. The agent never does.
OPENROUTER_API_KEY=

# The model the agent uses: "openrouter/" + the model id from openrouter.ai/models.
BOX_MODEL=openrouter/z-ai/glm-5.3

# The gateway passes calls to BOX_MODEL only. If the agent may also use other models,
# list them here, comma-separated, without the "openrouter/" prefix.
BOX_EXTRA_MODELS=

# Where "box out" copies the outbox for your review (default: exports/ in this folder).
BOX_HANDOFF_DIR=

# The opencode release baked into the image. Change it, then: bin/box up && bin/box test && bin/box smoke
OPENCODE_VERSION=1.19.5

# Repositories that must never be granted with "box repo add", comma-separated.
# Good candidates: repos with secrets in their history, or with instructions your
# other tools trust.
BOX_NEVER_REPOS=

# How much of your machine the agent may use.
BOX_MEMORY=4g
BOX_CPUS=4
