#!/usr/bin/env bash
# box: start, drive, observe and stop the agent-box.
# Works with the bash that ships with macOS (3.2) and on Linux / WSL.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="$ROOT/.box"
WS_FILE="$STATE/workspace"

usage() {
  cat <<'EOF'
box: a coding agent in a sandbox

  Start and stop
    box start [workspace]  start the box and open the agent's terminal UI (up + code)
    box up [workspace]     build if needed and start the box (default workspace: "default")
    box down               stop the box (the agent's sessions are kept)
    box reset              stop the box and wipe the agent's home (sessions, caches)
    box status             what is running, which workspace, which model

  Work with the agent
    box code [--web]       open the agent's terminal UI (you talk to it directly)
    box run [--web] "task" give it one task without the UI; transcript saved in runs/
    box shell              a plain shell inside the box
    --web                  let the model search the web (OpenRouter server-side; logged)

  See what it can do and what it did
    box report             build status.html: what the agent can and cannot do, what it did
    box logs [-f]          every model call and every internet request
    box egress [-f]        internet requests only (allowed and denied)
    box test               containment self-test: tries to break out, expects to fail

  Open or close doors
    box reload             apply changes made to egress/allowlist.txt

  Repositories, one at a time
    box repo add <name>    grant one GitHub repository (fresh clone into workspaces/<name>)
    box repo list          which repositories are granted
    box repo sync [name]   bring the workspace up to date with GitHub
    box repo remove <name> take the grant back
    box pr [-t "title"]    turn the agent's commits into a pull request for you to review

  Take results out
    box diff [-p]          what changed in the workspace since "box up" (-p: full patch)
    box export [folder]    copy the workspace's plain files to exports/ for review

  Folders you share with the agent
    inbox/                 you drop things here; the agent can read, not change
    outbox/                the agent leaves things here for you
EOF
}

die() { echo "box: $*" >&2; exit 1; }

compose() { docker compose --project-directory "$ROOT" -f "$ROOT/compose.yaml" "$@"; }

current_ws() { if [ -f "$WS_FILE" ]; then cat "$WS_FILE"; else echo default; fi; }

# The model the agent runs, read from .env (falls back to the compose default).
current_model() {
  local m=""
  [ -f "$ROOT/.env" ] && m="$(grep -E '^BOX_MODEL=' "$ROOT/.env" 2>/dev/null | tail -1 | cut -d= -f2-)"
  echo "${m:-openrouter/z-ai/glm-5.3}"
}

# The model to run through OpenRouter's server-side web search: the configured model with
# an ":online" suffix. The search runs on OpenRouter, not in the box, so no door is opened
# and every call still shows up in logs/gateway.log.
online_model() {
  local m; m="$(current_model)"
  case "$m" in *:online) echo "$m" ;; *) echo "${m}:online" ;; esac
}

valid_name() {
  case "$1" in
    ""|.*|*[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

env_value() {  # env_value KEY -> value from .env, empty if missing
  [ -f "$ROOT/.env" ] || return 0
  grep -E "^$1=" "$ROOT/.env" | tail -n 1 | cut -d= -f2- || true
}

need_running() {
  [ -n "$(compose ps -q --status running agent 2>/dev/null)" ] || die "the box is not running. Start it with: box up"
}

# A fresh, throwaway container with no network that sees a workspace read-only.
# Used to look at what the agent produced without running anything of it on the host.
inspector() {
  docker run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges:true --tmpfs /tmp \
    -v "$ROOT/workspaces/$(current_ws):/workspace:ro" \
    -w /workspace agent-box/agent "$@" </dev/null
}

cmd_up() {
  local ws="${1:-$(current_ws)}"
  valid_name "$ws" || die "workspace names use letters, digits, dot, dash, underscore"
  mkdir -p "$STATE" "$ROOT/workspaces/$ws" "$ROOT/inbox" "$ROOT/outbox" "$ROOT/logs"
  echo "$ws" > "$WS_FILE"

  [ -f "$ROOT/.env" ] || cp "$ROOT/.env.example" "$ROOT/.env"
  if [ -z "$(env_value OPENROUTER_API_KEY)" ]; then
    echo "note: no OPENROUTER_API_KEY in .env yet. The box starts, but the model will answer 401."
  fi

  BOX_WORKSPACE="$ws" compose up -d --build --force-recreate agent gateway egress

  # A git baseline, so "box diff" can show exactly what the agent changed.
  compose exec -T agent sh -c '
    if [ ! -d .git ]; then git init -q; fi
    if ! git rev-parse -q --verify HEAD >/dev/null; then
      git add -A && git commit -q --allow-empty -m "baseline (box up)"
    fi
    git rev-parse HEAD' > "$STATE/baseline-$ws"

  echo
  echo "Box is up. Workspace: workspaces/$ws"
  echo "Next: box code   (talk to the agent)   |   box test   (check the walls)"
}

cmd_status() {
  compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
  echo "workspace: workspaces/$(current_ws)"
  if [ -n "$(compose ps -q --status running agent 2>/dev/null)" ]; then
    compose exec -T agent sh -c 'echo "model:     $BOX_MODEL"; echo "opencode:  $(opencode --version)"'
  fi
}

cmd_run() {
  need_running
  # --web turns on OpenRouter's server-side web search for this run only.
  local web=0 args=()
  for a in "$@"; do
    if [ "$a" = "--web" ]; then web=1; else args+=("$a"); fi
  done
  set -- ${args[@]+"${args[@]}"}
  [ $# -ge 1 ] || die 'usage: box run [--web] "task for the agent"'
  mkdir -p "$ROOT/runs"
  local stamp out mflag=()
  stamp="$(date +%Y%m%d-%H%M%S)-$(current_ws)"
  out="$ROOT/runs/$stamp.jsonl"
  if [ "$web" = 1 ]; then
    mflag=( -m "$(online_model)" )
    echo "web search ON: $(online_model)  (every model call may search; all calls are logged in logs/gateway.log)"
  fi
  # What was asked and of which model, next to the transcript.
  { compose exec -T agent sh -c 'echo "$BOX_MODEL"'
    [ "$web" = 1 ] && echo "web-search: ON ($(online_model))"
    printf '%s\n' "$*"; } > "$ROOT/runs/$stamp.task.txt"
  # --auto: do not stop to ask for permission. The box is the permission system.
  compose exec -T agent opencode run --auto --format json ${mflag[@]+"${mflag[@]}"} "$@" | tee "$out" | summarize
  echo
  echo "full transcript: ${out#$ROOT/}"
}

# Open the agent's terminal UI, optionally with web search on (box code [--web]).
cmd_code() {
  need_running
  local web=0 args=()
  for a in "$@"; do
    if [ "$a" = "--web" ]; then web=1; else args+=("$a"); fi
  done
  local mflag=()
  if [ "$web" = 1 ]; then
    mflag=( -m "$(online_model)" )
    echo "web search ON: $(online_model)  (model calls may search; see logs/gateway.log)"
  fi
  compose exec agent opencode ${mflag[@]+"${mflag[@]}"} ${args[@]+"${args[@]}"}
}

# Turn opencode's JSON event stream into a short readable trace.
summarize() {
  python3 -c '
import json, sys
for line in sys.stdin:
    try:
        e = json.loads(line)
    except ValueError:
        continue
    part = e.get("part") or {}
    kind = e.get("type")
    if kind == "text" and part.get("text"):
        print(part["text"].strip())
    elif kind == "tool_use":
        state = part.get("state") or {}
        inp = state.get("input") or {}
        hint = inp.get("command") or inp.get("filePath") or inp.get("pattern") or ""
        print("  [%s] %s" % (part.get("tool", "tool"), str(hint)[:100]))
    elif kind == "error":
        print("  [error] %s" % json.dumps(e.get("error", e))[:300])
' 2>/dev/null || cat
}

cmd_test() {
  need_running
  mkdir -p "$STATE"
  local tmp="$STATE/last-test.tmp" rc=0
  echo "# $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"
  local started; started="$(date -u +%Y-%m-%dT%H:%M:%S)"
  compose exec -T agent /opt/agent-box/selftest.sh | tee -a "$tmp" || rc=$?
  mv "$tmp" "$STATE/last-test.txt"
  # The test knocks on doors on purpose. Remember when, so the report can tell
  # its attempts apart from the agent's.
  sleep 1
  echo "$started $(date -u +%Y-%m-%dT%H:%M:%S)" >> "$STATE/test-windows"
  return $rc
}

cmd_logs() {  # cmd_logs <which: all|egress> [-f]
  local which="$1"; shift
  local files="$ROOT/logs/egress.log"
  mkdir -p "$ROOT/logs"; touch "$ROOT/logs/egress.log" "$ROOT/logs/gateway.log"
  if [ "${1:-}" = "-f" ]; then
    if [ "$which" = all ]; then tail -n 10 -f "$ROOT/logs/gateway.log" "$ROOT/logs/egress.log"
    else tail -n 20 -f "$files"; fi
  else
    if [ "$which" = all ]; then cat "$ROOT/logs/gateway.log" "$ROOT/logs/egress.log" | sort | tail -n 40
    else tail -n 40 "$files"; fi
  fi
}

cmd_diff() {
  local ws base; ws="$(current_ws)"
  [ -f "$STATE/baseline-$ws" ] || die "no baseline for workspace \"$ws\". Run: box up"
  base="$(cat "$STATE/baseline-$ws")"
  if [ "${1:-}" = "-p" ]; then
    inspector git --no-optional-locks --no-pager diff --no-ext-diff --no-textconv "$base"
  else
    echo "Changed since box up (workspace: $ws)"
    inspector git --no-optional-locks --no-pager diff --no-ext-diff --no-textconv --stat "$base"
    echo
    echo "New files not yet added to git:"
    inspector git --no-optional-locks ls-files --others --exclude-standard | sed 's/^/  /'
  fi
}

cmd_export() {
  local ws dest; ws="$(current_ws)"
  dest="${1:-$ROOT/exports/$ws-$(date +%Y%m%d-%H%M%S)}"
  [ ! -e "$dest" ] || die "$dest already exists"
  mkdir -p "$dest"
  # Regular files only: no .git folder, no symlinks, no devices.
  inspector sh -c 'find . -path ./.git -prune -o -type f -print0 | tar --null --no-recursion -cf - -T -' \
    | tar -xf - -C "$dest"
  echo "Copied to: $dest"
  local links execs
  links="$(inspector sh -c 'find . -path ./.git -prune -o -type l -printf "  %p -> %l\n"')"
  execs="$(inspector sh -c 'find . -path ./.git -prune -o -type f -perm /111 -printf "  %p\n"')"
  if [ -n "$links" ]; then echo "Left behind (symlinks; they could point at your own files):"; echo "$links"; fi
  if [ -n "$execs" ]; then echo "Marked executable (read before you run):"; echo "$execs"; fi
}

# ---------------------------------------------------------------- repositories
#
# One repository = one grant. For each granted repository we keep, outside the
# agent's reach, in .box/repos/<name>/:
#   clean/    a clone the agent never touches; pull requests are pushed from here
#   full      owner/name on GitHub
#   default   the default branch
#   known     commits GitHub already has; a pull request carries what comes after

repo_dir() { echo "$STATE/repos/$1"; }

is_sha() { case "$1" in *[!0-9a-f]*|"") return 1 ;; esac; [ ${#1} -eq 40 ]; }

cmd_repo_add() {
  [ $# -eq 1 ] || die "usage: box repo add <name>   (or owner/name)"
  command -v gh >/dev/null || die "the GitHub CLI (gh) is needed for repositories: https://cli.github.com"
  local spec="$1" name d never n
  name="${spec##*/}"
  valid_name "$name" || die "not a usable repository name: $name"

  never="$(env_value BOX_NEVER_REPOS)"
  local IFS_OLD="$IFS"; IFS=','
  for n in $never; do
    n="$(echo "$n" | tr -d ' ')"
    if [ "$n" = "$name" ]; then IFS="$IFS_OLD"; die "\"$name\" is on your never-grant list (BOX_NEVER_REPOS in .env)"; fi
  done
  IFS="$IFS_OLD"

  d="$(repo_dir "$name")"
  [ ! -e "$d" ] || die "\"$name\" is already granted"
  [ ! -e "$ROOT/workspaces/$name" ] || die "workspaces/$name already exists; move it away first"

  mkdir -p "$d"
  if ! gh repo clone "$spec" "$d/clean" -- --quiet; then
    rmdir "$d" 2>/dev/null || true
    die "could not clone $spec"
  fi
  git -C "$d/clean" remote get-url origin | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##' > "$d/full"
  git -C "$d/clean" symbolic-ref --short HEAD > "$d/default"
  git -C "$d/clean" rev-parse HEAD > "$d/known"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$d/added"

  # The agent's copy: same history, but no link back to GitHub and no credentials.
  git clone --quiet --no-hardlinks "$d/clean" "$ROOT/workspaces/$name"
  git -C "$ROOT/workspaces/$name" remote remove origin

  echo "Granted: $(cat "$d/full") -> workspaces/$name"
  echo "The agent can read and change this copy. It cannot push."
  echo "Next: box start $name"
}

cmd_repo_list() {
  local d any=0
  for d in "$STATE"/repos/*/; do
    [ -f "$d/full" ] || continue
    any=1
    printf '%-28s %-36s granted %s\n' "workspaces/$(basename "$d")" "$(cat "$d/full")" "$(cut -c1-10 "$d/added")"
  done
  [ $any -eq 1 ] || echo "No repositories granted. Grant one with: box repo add <name>"
}

cmd_repo_sync() {
  local name="${1:-$(current_ws)}" d default sha
  d="$(repo_dir "$name")"
  [ -f "$d/full" ] || die "\"$name\" is not a granted repository"
  default="$(cat "$d/default")"
  git -C "$d/clean" fetch --quiet origin
  sha="$(git -C "$d/clean" rev-parse "origin/$default")"
  grep -q "$sha" "$d/known" || echo "$sha" >> "$d/known"

  # Git on the agent's copy only ever runs inside a container.
  # Three outcomes, printed as the last line:
  #   ff     the workspace had nothing of its own; moved forward
  #   reset  its own commits are already contained in GitHub's branch (typical after
  #          a squash merge, where GitHub replaces them with one new commit), so
  #          nothing is lost by dropping them
  #   keep   it has work GitHub does not have; left untouched
  local result
  result="$(docker run --rm --network none --read-only --cap-drop ALL --tmpfs /tmp \
      -v "$ROOT/workspaces/$name:/workspace" -v "$d/clean:/clean:ro" -w /workspace \
      agent-box/agent sh -c '
        up="upstream/$1"
        git -c safe.directory="*" fetch -q /clean "refs/remotes/origin/$1:refs/remotes/$up" || { echo fail; exit 0; }
        if git merge -q --ff-only "$up" 2>/dev/null; then echo ff; exit 0; fi
        # Uncommitted changes to tracked files would be lost by a reset.
        if ! git diff --quiet HEAD 2>/dev/null; then echo keep; exit 0; fi
        # Merge the two in memory. If the result is exactly GitHub'"'"'s tree, the
        # workspace contributes nothing that GitHub does not already have.
        merged="$(git merge-tree --write-tree HEAD "$up" 2>/dev/null | head -n 1)" || merged=""
        if [ -n "$merged" ] && [ "$merged" = "$(git rev-parse "$up^{tree}")" ]; then
          git reset -q --hard "$up" && echo reset
        else
          echo keep
        fi' sh "$default" </dev/null | tail -n 1)"

  case "$result" in
    ff)
      echo "$sha" > "$STATE/baseline-$name"
      echo "workspaces/$name is up to date with $(cat "$d/full") ($default)." ;;
    reset)
      echo "$sha" > "$STATE/baseline-$name"
      echo "workspaces/$name is up to date with $(cat "$d/full") ($default)."
      echo "The agent's own commits were already contained in $default (merged pull request), so they were dropped." ;;
    keep)
      echo "GitHub's $default was fetched as upstream/$default. The workspace has work of its own that"
      echo "GitHub does not have, so it was left untouched."
      echo "Decide in 'box shell':   git rebase upstream/$default        keep that work on top"
      echo "                         git reset --hard upstream/$default  throw it away" ;;
    *)
      die "could not sync workspaces/$name" ;;
  esac
}

cmd_repo_remove() {
  [ $# -eq 1 ] || die "usage: box repo remove <name>"
  local name="$1" d
  valid_name "$name" || die "not a usable repository name: $name"
  d="$(repo_dir "$name")"
  [ -f "$d/full" ] || die "\"$name\" is not a granted repository"
  rm -rf "$d"
  echo "Grant removed. No pull requests can be opened from workspaces/$name any more."
  echo "The folder workspaces/$name is still on disk; delete it yourself when you no longer need it."
}

cmd_pr() {
  local title="" yes=0 allow=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -t) title="${2:-}"; shift 2 ;;
      -y) yes=1; shift ;;
      --allow-sensitive) allow=1; shift ;;
      *) die 'usage: box pr [-t "title"] [-y] [--allow-sensitive]' ;;
    esac
  done
  local ws d full default known not head count dirty branch bundle mb files blocked instr
  ws="$(current_ws)"; d="$(repo_dir "$ws")"
  [ -f "$d/full" ] || die "workspace \"$ws\" is not a granted repository (see: box repo add)"
  full="$(cat "$d/full")"; default="$(cat "$d/default")"

  not=""
  for known in $(cat "$d/known"); do is_sha "$known" && not="$not ^$known"; done

  # 1. Read the agent's commits inside a throwaway container.
  head="$(inspector git rev-parse HEAD)"
  is_sha "$head" || die "could not read the workspace's HEAD"
  # shellcheck disable=SC2086
  count="$(inspector git rev-list --count HEAD $not)"
  case "$count" in ""|*[!0-9]*) die "could not count the new commits" ;; esac
  [ "$count" -gt 0 ] || die "the agent has made no new commits in workspaces/$ws"
  dirty="$(inspector git --no-optional-locks status --porcelain | wc -l | tr -d ' ')"

  # 2. Carry them out as plain data (a git bundle) into the clean clone.
  branch="agent/$ws-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$STATE/tmp"; bundle="$STATE/tmp/$ws.bundle"
  # shellcheck disable=SC2086
  inspector git bundle create - HEAD $not > "$bundle" 2>/dev/null
  git -C "$d/clean" fetch --quiet origin
  git -C "$d/clean" -c fetch.fsckObjects=true fetch --quiet "$bundle" "HEAD:refs/heads/$branch"
  rm -f "$bundle"
  [ "$(git -C "$d/clean" rev-parse "$branch")" = "$head" ] || die "the carried-out commits do not match the workspace"

  # 3. Refuse changes to files that run by themselves once they are on GitHub or on your machine.
  mb="$(git -C "$d/clean" merge-base "$branch" "origin/$default")"
  files="$(git -C "$d/clean" diff --name-only "$mb" "$branch")"
  blocked="$(printf '%s\n' "$files" | grep -E '^"?(\.github|\.claude|\.vscode|\.devcontainer|\.husky|\.githooks)/' || true)"
  instr="$(printf '%s\n' "$files" | grep -E '(^|/)(CLAUDE\.md|AGENTS\.md|\.cursorrules)"?$' || true)"
  if [ -n "$blocked" ] && [ $allow -eq 0 ]; then
    git -C "$d/clean" branch -q -D "$branch"
    echo "Refused. These files run automatically (CI workflows, editor and agent settings):" >&2
    printf '%s\n' "$blocked" | sed 's/^/  /' >&2
    die "read them first; if they are fine, repeat with --allow-sensitive"
  fi

  # 4. Show what would be published and ask.
  echo "Pull request for $full"
  echo "  branch:  $branch  ->  $default"
  echo "  commits: $count"
  git -C "$d/clean" --no-pager diff --stat "$mb" "$branch" | sed 's/^/  /'
  [ "$dirty" = 0 ] || echo "  note: $dirty changed file(s) in the workspace are not committed and are NOT included"
  if [ -n "$instr" ]; then
    echo "  note: instruction files for AI agents changed; read them with extra care:"
    printf '%s\n' "$instr" | sed 's/^/    /'
  fi
  if [ $yes -eq 0 ]; then
    printf 'Push this branch and open the pull request? [y/N] '
    local answer=""; read -r answer || true
    case "$answer" in y|Y|yes) ;; *) git -C "$d/clean" branch -q -D "$branch"; die "nothing was pushed" ;; esac
  fi

  # 5. Push from the clean clone and open the pull request. The text is written here,
  #    not by the agent; its commit subjects are quoted inside a code block.
  [ -n "$title" ] || title="agent-box: $count commit(s) from workspace $ws"
  local body="$STATE/tmp/$ws.pr.md" url
  {
    echo "Opened with [agent-box](https://github.com/robertbarcik/agent-box) from commits made by a sandboxed coding agent."
    echo
    echo "- Model: \`$(env_value BOX_MODEL)\`"
    echo "- Commits: $count"
    echo "- The agent had no access to GitHub. A human ran \`box pr\`."
    echo
    echo "**Review before merging.** Treat this like a contribution from a stranger."
    echo
    echo '```text'
    git -C "$d/clean" --no-pager log --format='%h %s' "$mb..$branch" | tr -d '`' | sed 's/@/(at)/g'
    echo '```'
  } > "$body"
  git -C "$d/clean" push --quiet origin "$branch"
  url="$(gh pr create --repo "$full" --base "$default" --head "$branch" --title "$title" --body-file "$body")"
  rm -f "$body"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $full $branch $url" >> "$STATE/prs.log"
  echo "Opened: $url"
}

cmd_repo() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  case "$sub" in
    add)    cmd_repo_add "$@" ;;
    list)   cmd_repo_list ;;
    sync)   cmd_repo_sync "$@" ;;
    remove) cmd_repo_remove "$@" ;;
    *)      die "usage: box repo add|list|sync|remove" ;;
  esac
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  up)      cmd_up "$@" ;;
  start)   cmd_up "$@"; compose exec agent opencode ;;
  down)    compose down ;;
  reset)   compose down -v; echo "Agent home wiped. Workspaces on disk are untouched." ;;
  status)  cmd_status ;;
  code)    cmd_code "$@" ;;
  run)     cmd_run "$@" ;;
  shell)   need_running; compose exec agent bash ;;
  report)  python3 "$ROOT/lib/report.py" "$@" ;;
  logs)    cmd_logs all "$@" ;;
  egress)  cmd_logs egress "$@" ;;
  test)    cmd_test ;;
  reload)  compose exec -T egress squid -k reconfigure && echo "allowlist reloaded" ;;
  repo)    cmd_repo "$@" ;;
  pr)      cmd_pr "$@" ;;
  diff)    cmd_diff "$@" ;;
  export)  cmd_export "$@" ;;
  help|-h|--help) usage ;;
  *)       usage; exit 1 ;;
esac
