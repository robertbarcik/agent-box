# The gateway is the only way from the box to the model provider.
# It adds the real API key on the way out, so the agent never holds it.
# ${OPENROUTER_API_KEY} is filled in from the environment when the container starts.

log_format box '$time_iso8601 $request_method $uri status=$status '
               'upstream=$upstream_status secs=$request_time '
               'bytes_in=$request_length bytes_out=$body_bytes_sent';

server {
    listen 8080;
    access_log /box-logs/gateway.log box;

    # Docker's internal DNS; re-resolve the provider every 5 minutes.
    resolver 127.0.0.11 valid=300s ipv6=off;

    client_max_body_size 50m;
    client_body_buffer_size 2m;
    proxy_hide_header Set-Cookie;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Only the endpoints a coding agent needs. Everything else is refused,
    # including account and key-management endpoints.
    location ~ ^/api/v1/(chat/completions|responses|models)(/.*)?$ {
        set $upstream https://openrouter.ai;
        proxy_pass $upstream;

        proxy_set_header Host openrouter.ai;
        proxy_set_header Authorization "Bearer ${OPENROUTER_API_KEY}";
        proxy_set_header Cookie "";
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Token streaming: pass chunks through as they arrive.
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location / {
        return 403 "agent-box gateway: this path is not allowed\n";
    }
}
